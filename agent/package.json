{
  "name": "exitguard-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "node --import tsx src/probe.ts",
    "record": "node --import tsx src/recorder.ts",
    "loop": "node --import tsx src/loop.ts",
    "loop:replay": "node --import tsx src/replay.ts",
    "api": "node --import tsx src/api.ts",
    "replay": "node --import tsx src/replay.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "viem": "^2.57.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
