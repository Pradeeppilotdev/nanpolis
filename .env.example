# Root .env is ignored by Git. Never expose these values through VITE_* variables.
NANSEN_API_KEY=
MONAD_RPC_URL=https://rpc.monad.xyz

# Transaction mode: DRY_RUN (default), REPLAY (no submission), LIVE (signs transactions).
MODE=DRY_RUN
AGENT_PRIVATE_KEY=
# Used only by the Foundry deployment script.
DEPLOYER_PRIVATE_KEY=
MONADSCAN_API_KEY=

# Recorder and loop configuration.
NANSEN_TIMEFRAME=6h
POLL_INTERVAL_SECONDS=300
MAX_FIXTURE_AGE_MINUTES=20
# ONE_SHOT=1

# Local API. npm run dev sets DEMO_MODE=1; npm run dev:live sets it to 0.
PORT=8791
DEMO_MODE=0
