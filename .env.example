# Nansen
NANSEN_API_KEY=

# Monad deployer (admin) wallet - owns the ExitGuard position and safeAddr.
# Used by foundry scripts (`forge script`).
DEPLOYER_PRIVATE_KEY=

# Monad agent wallet (guard) - only allowed to call protect().
AGENT_PRIVATE_KEY=
MONAD_RPC_URL=https://rpc.monad.xyz
CHAIN_ID=143

# Deployed addresses (filled by foundry script / setup script)
EXITGUARD_ADDRESS=
MOCKTOKEN_ADDRESS=

# Agent behaviour
POLL_INTERVAL_SECONDS=300
DRY_RUN=true
REPLAY=false
CLUSTER_FILTER=0

# Optional: block explorer verification
MONADSCAN_API_KEY=
